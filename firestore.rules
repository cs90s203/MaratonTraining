rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Email addresses aren't case-sensitive, but `in [...]` is an exact string match — so
    // lower() the token before comparing, and keep every address below lowercase. Without
    // this, a token carrying different casing than the list is rejected as a stranger.
    // (This bit babylog once; same normalization must happen on the client too.)
    function authEmail() {
      return request.auth != null ? request.auth.token.email.lower() : '';
    }

    // 誰能用這個 App。加人 = 在這裡加一行小寫 email，然後在 Firebase 主控台重新發布規則。
    function isMember() {
      return request.auth != null &&
        authEmail() in [
          'cs90s203@gmail.com'
          // 伴侶 / 教練 / 其他共用者的 Google 帳號填在這裡，全部小寫，逗號分隔
        ];
    }

    // userId（data/users.json 裡的人類可讀字串，例如 "mick"）綁定哪個 email 才能寫。
    //
    // ⚠️ 這裡不能用 request.auth.uid == userId——Firebase Auth 的 uid 是登入時隨機
    // 產生的字串（例如 "AbC123XyZ..."），永遠不會等於 users.json 裡的 "mick"。
    // 兩者是不同的識別系統：uid 是「這次登入的裝置/帳號」，userId 是「App 裡的這個人」。
    // 這個對照表就是把兩者接起來的地方——只能放在 rules（gitignore 的 .local 版本），
    // 不能放進 data/users.json，那是公開的靜態資料，不該含任何人的 email。
    //
    // 寫法跟 babylog 的 isXxxFamily() 一樣：純 && / ||，不用連鎖的 ?:——Firebase 的規則
    // 編輯器在第三層 ?: 標了紅點（決策紀錄第 20 條），而 babylog 這種寫法已經在線上
    // 跑很久。加人＝加一行 ||（userId 要跟 data/users.json 一模一樣，大小寫也是）。
    function isSelf(userId) {
      return isMember() && (
        (userId == 'mick' && authEmail() == 'cs90s203@gmail.com')
        // || (userId == 'partner' && authEmail() == '伴侶的@gmail.com')
        // || (userId == 'coach'   && authEmail() == '教練的@gmail.com')
      );
    }

    // 教練（決策紀錄第 56 條）：排三個人的課表、改常用項目庫、幫別人設目標。
    // ⚠️ 要跟 data/users.json 裡 coach:true 的那個 userId 一樣（tests/harness22.js 會比對兩邊）。
    // 寫成 isSelf('mick') 而不是再寫一次 email：email 對照只留 isSelf() 一個地方。
    function isCoach() {
      return isSelf('mick');
    }

    // 訓練目標（profile/goals）、階段目標（profile/phaseTargets）：白名單內都看得到。
    // 寫入：本人，或教練幫忙設（第 56 條，取代第 15 條「白名單內任何人都能寫」）。
    // 這個集合不放身體狀況等敏感資料——那些走 private/ 子集合（下面），isSelf 才能寫。
    match /users/{userId}/profile/{doc} {
      allow read:  if isMember();
      allow write: if isSelf(userId) || isCoach();
    }

    // 完成紀錄（status / 實際時長 / 距離）：白名單內都看得到，只有本人能寫。
    // 規格書原本寫「唯讀,不能改別人的紀錄」——那句話要成立，靠的是這一行，不是 UI 沒放按鈕。
    match /users/{userId}/entries/{date} {
      allow read:  if isMember();
      allow write: if isSelf(userId);
    }

    // 身體狀況（漏尿 / 疼痛 / 過度疲勞 / 自由文字）：只有本人讀得到。
    // 白名單內的其他人——包含伴侶與教練——一律讀不到。要分享的話是改這一行，
    // 不是在前端多顯示一個欄位。決策紀錄第 2 條。
    match /users/{userId}/private/{date} {
      allow read, write: if isSelf(userId);
    }

    // 週調整（決策紀錄第 0 條：「本週已降量」的標記）：跟 entries 同層級的可見性。
    match /users/{userId}/weekAdjustments/{week} {
      allow read:  if isMember();
      allow write: if isSelf(userId);
    }

    // 課表：每個人一份（決策紀錄第 56 條，一份文件＝這個人的一整週）。白名單內都看得到
    // （總覽算完成率、唯讀看別人的紀錄要用）；本人跟教練能改。
    // 出廠預設值（data/plan.json）維持 git 版控、不受影響；這裡只存「被改過的週」。
    match /users/{userId}/planWeeks/{week} {
      allow read:  if isMember();
      allow write: if isSelf(userId) || isCoach();
    }

    // v0.25 以前三人共用的那一份課表：第 56 條之後唯讀。新版 App 在某人某週還沒有自己那份時讀它；
    // 還開著舊版的手機去改會被拒（畫面會出現「寫入被拒」），不會悄悄改到沒人讀的地方。
    match /planOverrides/{weekNumber} {
      allow read:  if isMember();
      allow write: if false;
    }

    // 常用項目庫（決策紀錄第 26 條）：常用項目、自訂動作清單、自訂影片。白名單內都讀得到（挑項目用），
    // 只有教練能改——改了會套用到三個人的課表（第 52、56 條）。
    match /library/{docId} {
      allow read:  if isMember();
      allow write: if isCoach();
    }

    // 其餘一律拒絕。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
